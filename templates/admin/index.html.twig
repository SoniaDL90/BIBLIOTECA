{% extends 'base.html.twig' %}

{% block title %}Panel de administración{% endblock %}

{% block body %}
<h1 class="mb-4">⚙️ Panel de administración</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body text-center">
                <h2>{{ totalLibros }}</h2>
                <p class="mb-0">📚 Libros</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body text-center">
                <h2>{{ totalUsuarios }}</h2>
                <p class="mb-0">👤 Usuarios</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body text-center">
                <h2>{{ prestamosActivos }}</h2>
                <p class="mb-0">📖 Préstamos activos</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body text-center">
                <h2>{{ prestamosRetrasados }}</h2>
                <p class="mb-0">⚠️ Retrasados</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h3>🏆 Top 5 libros más prestados</h3>
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Libro</th>
                    <th>Préstamos</th>
                </tr>
            </thead>
            <tbody>
                {% for item in topLibros %}
                <tr>
                    <td>{{ item.titulo }}</td>
                    <td>{{ item.total }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="2" class="text-center">No hay datos</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h3>🔗 Accesos rápidos</h3>
        <div class="d-grid gap-2">
            <a href="{{ path('app_book_index') }}" class="btn btn-primary">Gestionar libros</a>
            <a href="{{ path('app_admin_loans') }}" class="btn btn-info">Ver todos los préstamos</a>
        </div>
    </div>
</div>
{% endblock %}
